{
    "name": "kzxl/liteorm",
    "description": "High-performance PHP 8.2+ ORM with zero-reflection runtime, fluent query builder, and built-in caching",
    "type": "library",
    "license": "Apache-2.0",
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "LiteORM\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LiteORM\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always"
    }
}
